{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baton",
  "version": "0.1.0",
  "identifier": "dev.nishanprime.baton",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Baton",
        "width": 420,
        "height": 560,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../../dist/cli.mjs": "cli.mjs"
    }
  }
}
